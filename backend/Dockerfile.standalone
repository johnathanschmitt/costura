# Build isolado: contexto = ./backend (para testar sem o monorepo)
#   docker build -f backend/Dockerfile.standalone --target production -t costura-backend ./backend
# Usa `npm install` porque o package-lock.json fica na raiz do monorepo,
# fora deste contexto — para build determinístico use backend/Dockerfile.
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache openssl

FROM base AS deps
COPY package.json ./
RUN npm install --include=dev \
 && test -x node_modules/.bin/nest && test -x node_modules/.bin/prisma

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate
RUN npm run build

FROM base AS production
ENV NODE_ENV=production
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
COPY package.json ./
EXPOSE 3000
# tsc emite dist/src/main.js (prisma/seed.ts também entra na compilação, deslocando o rootDir)
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/main"]
