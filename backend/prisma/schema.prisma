generator client {
  provider = "prisma-client-js"
  // "native" = host; "debian-openssl-3.0.x" = contêiner (node:20-bookworm).
  // O contêiner monta o node_modules do host, então o engine da plataforma dele
  // precisa existir mesmo quando o host detecta outra versão de OpenSSL.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@map("roles")
}

model Permission {
  id       String           @id @default(cuid())
  action   String
  resource String
  roles    RolePermission[]
  createdAt DateTime        @default(now())

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  active       Boolean    @default(true)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  schedules    Schedule[]
  auditLogs    AuditLog[]
  inventoryMovements InventoryMovement[]
  assignedWorkOrders  WorkOrder[] @relation("WorkOrderAssignee")
  deliveredWorkOrders WorkOrder[] @relation("WorkOrderDeliverer")
  cancelledWorkOrders WorkOrder[] @relation("WorkOrderCanceller")
  workOrderUpdates    WorkOrderUpdate[]
  inventoryCounts     InventoryCount[]
  quoteSends          QuoteSend[]
  cashTransactions    CashTransaction[]
  accountTransfers    AccountTransfer[]
  cashRegistersOpened CashRegister[] @relation("CashOpenedBy")
  cashRegistersClosed CashRegister[] @relation("CashClosedBy")
  paymentsReversed    Payment[]      @relation("PaymentReversedBy")
  /// Horas de produção que esta costureira dá conta por dia.
  dailyCapacityHours  Decimal   @default(8) @db.Decimal(4, 2)
  /// Sócia do ateliê: participa da divisão do resultado no fim do mês.
  isPartner           Boolean   @default(false)
  /// Percentual do resultado que cabe a esta sócia. A soma dos percentuais das
  /// sócias mais o do ateliê tem que fechar 100%.
  distributionPercent Decimal?  @db.Decimal(5, 2)
  distributionShares  DistributionShare[]
  partnerPayouts      PartnerPayout[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@map("users")
}

// ── Clientes ──────────────────────────────────────────────────────────────────

model Customer {
  id                 String              @id @default(cuid())
  name               String
  email              String?
  phone              String?
  phone2             String?
  cpf                String?             @unique
  birthDate          DateTime?
  address            Json?
  notes              String?
  measurements       BodyMeasurement[]
  quotes             Quote[]
  workOrders         WorkOrder[]
  schedules          Schedule[]
  accountsReceivable AccountReceivable[]
  attachments        Attachment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@map("customers")
}

model BodyMeasurement {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  bust         Float?
  waist        Float?
  hip          Float?
  shoulder     Float?
  backLength   Float?
  frontLength  Float?
  sleeveLength Float?
  inseam       Float?
  thigh        Float?
  neckCirc     Float?
  wrist        Float?
  /// Tipos de medida extras informados pelo ateliê: [{ label, value }]
  custom       Json?
  notes        String?
  version      Int      @default(1)
  takenAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("body_measurements")
}

// ── Catálogo ──────────────────────────────────────────────────────────────────

model Service {
  id             String          @id @default(cuid())
  name           String
  description    String?
  basePrice      Decimal         @db.Decimal(10, 2)
  unit           String          @default("un")
  active         Boolean         @default(true)
  /// Horas típicas de execução — usado para estimar a carga da costureira.
  estimatedHours Decimal?        @db.Decimal(6, 2)
  quoteItems     QuoteItem[]
  workOrderItems WorkOrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@map("services")
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String?         @unique
  description    String?
  unit           String          @default("un")
  costPrice      Decimal?        @db.Decimal(10, 2)
  salePrice      Decimal?        @db.Decimal(10, 2)
  active         Boolean         @default(true)
  inventory      Inventory?
  movements      InventoryMovement[]
  quoteItems     QuoteItem[]
  workOrderItems WorkOrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@map("products")
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @db.Decimal(10, 3)
  minQuantity Decimal  @default(0) @db.Decimal(10, 3)
  location    String?
  updatedAt   DateTime @updatedAt

  @@map("inventory")
}

// Livro-razão do estoque: uma linha por movimentação, com o saldo resultante
// gravado. O saldo em `Inventory` é o acumulado; aqui fica a rastreabilidade de
// como se chegou nele — quem mexeu, quando, por quê e com qual documento.
model InventoryMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  type          MovementType
  // Sempre positiva — para exibição.
  quantity      Decimal      @db.Decimal(10, 3)
  // Variação com sinal aplicada ao saldo. IN é sempre positiva e OUT negativa,
  // mas ADJUSTMENT vai para os dois lados — só aqui dá para saber falta de sobra.
  delta         Decimal      @default(0) @db.Decimal(10, 3)
  balanceAfter  Decimal      @db.Decimal(10, 3)
  unitCost      Decimal?     @db.Decimal(10, 2)
  totalCost     Decimal?     @db.Decimal(10, 2)
  supplier      String?
  invoiceNumber String?
  // Preenchido quando a baixa foi consumo de uma ordem de serviço.
  workOrderId   String?
  workOrder     WorkOrder?   @relation(fields: [workOrderId], references: [id])
  reason        String?
  notes         String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  attachments   Attachment[]
  // Agrupa os ajustes feitos numa mesma sessão de contagem.
  inventoryCountId String?
  inventoryCount   InventoryCount? @relation(fields: [inventoryCountId], references: [id])
  occurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([productId, occurredAt])
  @@index([type, occurredAt])
  @@map("inventory_movements")
}

/// Sessão de inventário: a contagem física de um dia, com seus ajustes.
model InventoryCount {
  id        String              @id @default(cuid())
  startedAt DateTime            @default(now())
  closedAt  DateTime?
  notes     String?
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  movements InventoryMovement[]

  @@map("inventory_counts")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Garment {
  id          String      @id @default(cuid())
  name        String
  category    String?
  description String?
  imageUrl    String?
  active      Boolean     @default(true)
  workOrders  WorkOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@map("garments")
}

// ── Orçamentos ────────────────────────────────────────────────────────────────

model Quote {
  id          String      @id @default(cuid())
  number      String      @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime?
  // Prazo de entrega prometido à cliente — herdado pela OS na conversão.
  deliveryDate DateTime?
  notes       String?
  // Desconto aplicado sobre o subtotal, além dos descontos por item.
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  // Token do link público: permite a cliente abrir o orçamento sem login.
  publicToken String?     @unique
  items       QuoteItem[]
  workOrder   WorkOrder?
  schedules   Schedule[]
  sends       QuoteSend[]
  attachments Attachment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@map("quotes")
}

/// Registro de cada envio do orçamento à cliente.
model QuoteSend {
  id        String       @id @default(cuid())
  quoteId   String
  quote     Quote        @relation(fields: [quoteId], references: [id])
  channel   SendChannel
  /// Número ou e-mail para onde foi, como estava no momento do envio.
  recipient String?
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  sentAt    DateTime     @default(now())

  @@index([quoteId, sentAt])
  @@map("quote_sends")
}

enum SendChannel {
  WHATSAPP
  EMAIL
  LINK
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id])
  type        ItemType
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  // Desconto em reais sobre a linha (quantidade × preço).
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  order       Int      @default(0)

  @@map("quote_items")
}

enum ItemType {
  SERVICE
  PRODUCT
  CUSTOM
}

// ── Ordens de Serviço ─────────────────────────────────────────────────────────

model WorkOrder {
  id                 String              @id @default(cuid())
  number             String              @unique
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id])
  quoteId            String?             @unique
  quote              Quote?              @relation(fields: [quoteId], references: [id])
  garmentId          String?
  garment            Garment?            @relation(fields: [garmentId], references: [id])
  status             WorkOrderStatus     @default(PENDING)
  priority           Priority            @default(NORMAL)
  dueDate            DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  deliveredAt        DateTime?
  // Costureira responsável pela produção.
  assignedToId       String?
  assignedTo         User?               @relation("WorkOrderAssignee", fields: [assignedToId], references: [id])
  // Medidas da peça, quando diferem da ficha da cliente.
  measurements       Json?
  // Entrega: quem do ateliê entregou e quem retirou.
  deliveredById      String?
  deliveredBy        User?               @relation("WorkOrderDeliverer", fields: [deliveredById], references: [id])
  // ── Cancelamento ──
  // A cliente pode desistir. A OS não é apagada: fica cancelada, com o motivo,
  // porque o trabalho já feito e o dinheiro já movimentado continuam existindo.
  cancelledAt        DateTime?
  cancelReason       String?
  cancelledById      String?
  cancelledBy        User?               @relation("WorkOrderCanceller", fields: [cancelledById], references: [id])
  receivedBy         String?
  // Andamento da produção, em passos de 25%.
  progressPct        Int                 @default(0)
  // Horas estimadas de trabalho, base do cálculo de carga da costureira.
  estimatedHours     Decimal?            @db.Decimal(6, 2)
  updates            WorkOrderUpdate[]
  notes              String?
  internalNotes      String?
  discount           Decimal             @default(0) @db.Decimal(10, 2)
  total              Decimal             @default(0) @db.Decimal(10, 2)
  paidAmount         Decimal             @default(0) @db.Decimal(10, 2)
  items              WorkOrderItem[]
  schedules          Schedule[]
  attachments        Attachment[]
  accountsReceivable AccountReceivable[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@map("work_orders")
}

/// Registro de progresso da OS: o que foi feito, quando e por quem.
model WorkOrderUpdate {
  id          String       @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id])
  note        String
  progressPct Int?
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  attachments Attachment[]
  createdAt   DateTime     @default(now())

  @@index([workOrderId, createdAt])
  @@map("work_order_updates")
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_MATERIAL
  FITTING
  DONE
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  type        ItemType
  serviceId   String?
  service     Service?  @relation(fields: [serviceId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal   @db.Decimal(10, 3)
  unitPrice   Decimal   @db.Decimal(10, 2)
  discount    Decimal   @default(0) @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)
  done        Boolean   @default(false)
  order       Int       @default(0)

  @@map("work_order_items")
}

// ── Agenda ────────────────────────────────────────────────────────────────────

model Schedule {
  id          String       @id @default(cuid())
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  workOrderId String?
  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id])
  quoteId     String?
  quote       Quote?       @relation(fields: [quoteId], references: [id])
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  type        ScheduleType
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean      @default(false)
  status      ApptStatus   @default(SCHEDULED)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@map("schedules")
}

enum ScheduleType {
  FITTING
  DELIVERY
  CONSULTATION
  MEASUREMENT
  QUOTE
  OTHER
}

enum ApptStatus {
  SCHEDULED
  CONFIRMED
  DONE
  CANCELLED
  NO_SHOW
}

// ── Financeiro ────────────────────────────────────────────────────────────────

/// Onde o dinheiro fica: a gaveta, a conta do banco, a chave PIX, o cofre e a
/// reserva do ateliê. Antes só a gaveta tinha saldo — o dinheiro que entrava por
/// Pix ou cartão virava um pagamento e não somava em lugar nenhum.
model FinancialAccount {
  id             String            @id @default(cuid())
  name           String            @unique
  kind           AccountKind
  active         Boolean           @default(true)
  /// Saldo que já existia quando a conta foi cadastrada.
  openingBalance Decimal           @default(0) @db.Decimal(10, 2)
  /// Conta sugerida para recebimentos que não são em espécie.
  isDefault      Boolean           @default(false)
  /// Contas do sistema (Gaveta, Reserva do ateliê) não podem ser removidas.
  isSystem       Boolean           @default(false)
  /// Até quando o extrato foi conferido contra o extrato do banco. O que vier
  /// depois desta data ainda não passou pelos olhos de ninguém.
  reconciledUntil DateTime?
  order          Int               @default(0)
  payments       Payment[]
  transfersOut   AccountTransfer[] @relation("TransferFrom")
  transfersIn    AccountTransfer[] @relation("TransferTo")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("financial_accounts")
}

enum AccountKind {
  /// A gaveta do balcão — o que o caixa controla.
  CASH_DRAWER
  BANK
  /// Carteira digital / chave PIX que não cai direto no banco.
  WALLET
  SAFE
  /// Reserva do ateliê: a parte do resultado que não é dividida.
  RESERVE
}

/// Dinheiro que muda de lugar sem ser receita nem despesa: sangria da gaveta
/// para o banco, aporte do banco para a reserva, troco levado para o caixa.
model AccountTransfer {
  id            String           @id @default(cuid())
  fromAccountId String
  fromAccount   FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  amount        Decimal          @db.Decimal(10, 2)
  reason        String
  /// Conferido contra o extrato do banco.
  reconciledAt  DateTime?
  /// Lançamento do caixa que originou a transferência, quando veio de sangria.
  cashTransactionId String?      @unique
  userId        String?
  user          User?            @relation(fields: [userId], references: [id])
  createdAt     DateTime         @default(now())

  @@index([createdAt])
  @@map("account_transfers")
}

model CashRegister {
  id             String             @id @default(cuid())
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  openingBalance Decimal            @default(0) @db.Decimal(10, 2)
  // Saldo que o sistema calcula que deveria haver na gaveta ao fechar.
  closingBalance Decimal?           @db.Decimal(10, 2)
  // Dinheiro efetivamente contado pela usuária no fechamento.
  countedBalance Decimal?           @db.Decimal(10, 2)
  // countedBalance - closingBalance: negativo = falta, positivo = sobra.
  difference     Decimal?           @db.Decimal(10, 2)
  status         CashRegisterStatus @default(OPEN)
  notes          String?
  /// Quem abriu e quem fechou. Num caixa com mais de uma pessoa, é o que
  /// permite conversar sobre uma diferença sem adivinhação.
  openedById     String?
  openedBy       User?              @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedById     String?
  closedBy       User?              @relation("CashClosedBy", fields: [closedById], references: [id])
  /// Contagem por cédula informada no fechamento: { "100": 3, "50": 2, ... }.
  countBreakdown Json?
  transactions   CashTransaction[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("cash_registers")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashTransaction {
  id             String          @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id])
  type           TransactionType
  category       String?
  description    String
  amount         Decimal         @db.Decimal(10, 2)
  paymentMethod  PaymentMethod   @default(CASH)
  // Distingue resultado (venda/despesa) de simples transferência de dinheiro
  // (sangria/suprimento), que não é receita nem despesa do ateliê.
  kind           CashMovementKind @default(OTHER)
  referenceId    String?
  referenceType  String?
  /// Para onde foi a sangria (ou de onde veio o suprimento): banco, cofre,
  /// fornecedor, retirada de sócia. Sem isso o dinheiro sai da gaveta e some.
  counterpart    String?
  /// Quem lançou.
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  payment        Payment?
  createdAt      DateTime        @default(now())

  @@index([createdAt])
  @@map("cash_transactions")
}

enum CashMovementKind {
  SALE
  EXPENSE
  /// Sangria: dinheiro sai da gaveta para o banco ou cofre.
  WITHDRAWAL
  /// Suprimento: dinheiro entra na gaveta para formar troco.
  SUPPLY
  /// Espelho de uma baixa de conta a receber ou a pagar.
  ACCOUNT
  /// Contrapartida de uma baixa estornada: acerta a gaveta sem virar resultado
  /// (o pagamento estornado já saiu das somas).
  REVERSAL
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  TRANSFER
  CHECK
  OTHER
}

// Livro-razão de pagamentos: uma linha por baixa realizada, seja de conta a
// receber ou a pagar. É a fonte da verdade do fluxo de caixa — datada por
// pagamento, e não pela quitação final da conta.
model Payment {
  id                String             @id @default(cuid())
  type              PaymentType
  receivableId      String?
  receivable        AccountReceivable? @relation(fields: [receivableId], references: [id])
  payableId         String?
  payable           AccountPayable?    @relation(fields: [payableId], references: [id])
  amount            Decimal            @db.Decimal(10, 2)
  method            PaymentMethod
  // Em dinheiro: quanto a cliente entregou e o troco devolvido.
  amountTendered    Decimal?           @db.Decimal(10, 2)
  changeGiven       Decimal?           @db.Decimal(10, 2)
  paidAt            DateTime           @default(now())
  /// Em qual conta o dinheiro entrou (ou de qual saiu). Espécie vai para a
  /// gaveta; Pix, cartão e transferência, para a conta escolhida.
  accountId         String?
  account           FinancialAccount?  @relation(fields: [accountId], references: [id])
  // Preenchido apenas quando a baixa foi em espécie e havia caixa aberto.
  cashTransactionId String?            @unique
  cashTransaction   CashTransaction?   @relation(fields: [cashTransactionId], references: [id])
  notes             String?
  // ── Cartão ──
  // Na maquininha o que a cliente paga não é o que cai na conta: a taxa fica
  // com a adquirente e o líquido só chega dias depois.
  /// Taxa retida pela maquininha nesta venda.
  feeAmount         Decimal?           @db.Decimal(10, 2)
  /// O que efetivamente cai na conta (bruto − taxa).
  netAmount         Decimal?           @db.Decimal(10, 2)
  /// Data em que o dinheiro fica disponível. Até lá não entra no saldo.
  availableAt       DateTime?
  /// Conferido contra o extrato do banco.
  reconciledAt      DateTime?
  // ── Estorno ──
  // A baixa errada não é apagada: fica marcada como estornada e sai de todas as
  // somas. Apagar esconderia que houve o erro.
  reversedAt        DateTime?
  reversedReason    String?
  reversedById      String?
  reversedBy        User?              @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  createdAt         DateTime           @default(now())

  @@index([paidAt])
  @@index([type, paidAt])
  @@map("payments")
}

enum PaymentType {
  RECEIVABLE
  PAYABLE
}

model AccountReceivable {
  id            String           @id @default(cuid())
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id])
  workOrderId   String?
  workOrder     WorkOrder?       @relation(fields: [workOrderId], references: [id])
  description   String
  amount        Decimal          @db.Decimal(10, 2)
  paidAmount    Decimal          @default(0) @db.Decimal(10, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        ReceivableStatus @default(PENDING)
  paymentMethod PaymentMethod?
  payments      Payment[]
  // Parcelamento: as parcelas de uma mesma venda compartilham o grupo.
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  // Sinal (entrada) é separado do pagamento final para leitura do fluxo.
  isDownPayment Boolean          @default(false)
  // Categoria de receita, para o DRE.
  category      String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([status, dueDate])
  @@map("accounts_receivable")
}

enum ReceivableStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model AccountPayable {
  id            String        @id @default(cuid())
  supplier      String?
  description   String
  category      String?
  amount        Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        PayableStatus @default(PENDING)
  paymentMethod PaymentMethod?
  payments      Payment[]
  // Recorrência: a conta-mãe gera as próximas ocorrências automaticamente.
  recurrence    Recurrence    @default(NONE)
  parentId      String?
  parent        AccountPayable?  @relation("PayableRecurrence", fields: [parentId], references: [id])
  occurrences   AccountPayable[] @relation("PayableRecurrence")
  attachments   Attachment[]
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([status, dueDate])
  @@map("accounts_payable")
}

enum PayableStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

/// Divisão do resultado de um mês entre as sócias e o ateliê.
model MonthlyDistribution {
  id            String   @id @default(cuid())
  /// Mês no formato AAAA-MM.
  month         String   @unique
  /// Resultado apurado no momento do fechamento — congelado aqui para que
  /// lançamentos posteriores não mudem uma divisão já acertada.
  result        Decimal  @db.Decimal(10, 2)
  /// Quantidade de partes: uma por sócia mais a do ateliê.
  parts         Int
  valuePerPart  Decimal  @db.Decimal(10, 2)
  /// Parte que fica no ateliê para as despesas.
  atelierShare  Decimal  @db.Decimal(10, 2)
  /// Percentual do ateliê aplicado neste fechamento. Guardado aqui para que
  /// mudar a regra depois não reescreva o que já foi acertado.
  atelierPercent Decimal? @db.Decimal(5, 2)
  /// Resultado bruto do mês, antes de tirar os sinais e o prejuízo anterior.
  grossResult    Decimal? @db.Decimal(10, 2)
  /// Sinais de peças não entregues descontados do bolo.
  withheldSignals Decimal? @db.Decimal(10, 2)
  /// Prejuízo de meses anteriores abatido neste fechamento.
  carryOverUsed   Decimal? @db.Decimal(10, 2)
  notes         String?
  closedAt      DateTime @default(now())
  shares        DistributionShare[]
  payouts       PartnerPayout[]

  @@map("monthly_distributions")
}

model DistributionShare {
  id             String              @id @default(cuid())
  distributionId String
  distribution   MonthlyDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  /// Nome no momento do fechamento, para o histórico não mudar depois.
  name           String
  amount         Decimal             @db.Decimal(10, 2)
  /// Percentual aplicado a esta sócia no fechamento.
  percent        Decimal?            @db.Decimal(5, 2)
  /// Produção da sócia no mês, para leitura junto do valor.
  deliveredCount Int                 @default(0)
  deliveredValue Decimal             @default(0) @db.Decimal(10, 2)

  @@unique([distributionId, userId])
  @@map("distribution_shares")
}

/// Retirada da sócia referente a um mês fechado.
///
/// É o que impede dividir o mesmo dinheiro duas vezes: enquanto `paidAt` for
/// nulo, o valor continua devido a ela e aparece como "a retirar".
model PartnerPayout {
  id             String              @id @default(cuid())
  distributionId String
  distribution   MonthlyDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  amount         Decimal             @db.Decimal(10, 2)
  paidAt         DateTime?
  /// De qual conta o dinheiro saiu quando a sócia retirou.
  accountId      String?
  notes          String?
  createdAt      DateTime            @default(now())

  @@unique([distributionId, userId])
  @@map("partner_payouts")
}

/// Regra de divisão válida só para um mês.
///
/// Existe para o caso pontual — uma sócia afastada em julho, por exemplo — sem
/// mexer na regra padrão nem nos meses já fechados.
model MonthlyDistributionRule {
  id             String   @id @default(cuid())
  /// Mês no formato AAAA-MM.
  month          String   @unique
  atelierPercent Decimal  @db.Decimal(5, 2)
  /// [{ userId, percent }] — congelado como veio da tela.
  shares         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("monthly_distribution_rules")
}

/// Prejuízo de um mês que a reserva não cobriu e será abatido do próximo
/// resultado antes de dividir.
model DistributionCarryOver {
  id        String   @id @default(cuid())
  /// Mês que gerou o prejuízo (AAAA-MM).
  month     String   @unique
  amount    Decimal  @db.Decimal(10, 2)
  /// Mês em que foi abatido; nulo enquanto ainda pesa.
  settledIn String?
  createdAt DateTime @default(now())

  @@map("distribution_carry_overs")
}

enum Recurrence {
  NONE
  MONTHLY
  YEARLY
}

/// Categorias de receita e despesa. Alimentam os seletores e o DRE.
model FinancialCategory {
  id       String       @id @default(cuid())
  name     String
  type     CategoryType
  active   Boolean      @default(true)
  /// Categorias padrão do sistema não podem ser removidas.
  isSystem Boolean      @default(false)
  /// Despesa que se repete todo mês (aluguel, luz, água, internet). A soma
  /// delas é o custo fixo, que define quanto o ateliê precisa faturar para
  /// empatar. Não faz sentido em categoria de receita.
  isFixed  Boolean      @default(false)
  createdAt DateTime    @default(now())

  @@unique([name, type])
  @@map("financial_categories")
}

enum CategoryType {
  INCOME
  EXPENSE
}

// ── Anexos ────────────────────────────────────────────────────────────────────

model Attachment {
  id                  String             @id @default(cuid())
  fileName            String
  originalName        String
  mimeType            String
  size                Int
  url                 String
  customerId          String?
  customer            Customer?          @relation(fields: [customerId], references: [id])
  quoteId             String?
  quote               Quote?             @relation(fields: [quoteId], references: [id])
  workOrderId         String?
  workOrder           WorkOrder?         @relation(fields: [workOrderId], references: [id])
  inventoryMovementId String?
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id])
  workOrderUpdateId   String?
  workOrderUpdate     WorkOrderUpdate?   @relation(fields: [workOrderUpdateId], references: [id])
  /// Comprovante ou nota fiscal da despesa.
  accountPayableId    String?
  accountPayable      AccountPayable?    @relation(fields: [accountPayableId], references: [id])
  // Separa foto de referência de foto do tecido recebido, etc.
  kind                AttachmentKind     @default(DOCUMENT)
  caption             String?
  createdAt           DateTime           @default(now())

  @@index([workOrderId, kind])
  @@map("attachments")
}

enum AttachmentKind {
  DOCUMENT
  REFERENCE
  FABRIC
  PROGRESS
}

// ── Configurações do negócio ──────────────────────────────────────────────────

model BusinessInfo {
  id          String   @id @default(cuid())
  name        String   @default("Ateliê de Costura")
  logoBase64  String?  @db.Text
  tagline     String?
  address     String?
  city        String?
  phone       String?
  email       String?
  website     String?
  taxId       String?
  footerText  String?
  // ── Redes sociais ──
  /// WhatsApp comercial do ateliê (o que aparece nos documentos).
  whatsapp    String?
  instagram   String?
  facebook    String?
  tiktok      String?
  // Dias de validade padrão de um orçamento enviado; passado disso ele expira.
  quoteValidityDays Int @default(15)
  // Fila de uma costureira acima disto (em dias de trabalho) dispara alerta.
  queueAlertDays    Int @default(7)
  /// Modelo da mensagem de WhatsApp. Aceita {cliente} {numero} {total} {link} {ateliê}.
  whatsappTemplate  String? @db.Text
  /// Conferência às cegas: o fechamento não mostra o saldo esperado até a
  /// contagem ser informada. Sem isso, o número na tela vira a resposta.
  blindCashCount    Boolean  @default(false)
  // ── Parâmetros do financeiro ──
  /// Quanto o ateliê quer ganhar por hora de costura. Sem meta, o painel mostra
  /// o realizado sem comparação.
  targetHourlyRate  Decimal? @db.Decimal(10, 2)
  /// Como estimar o custo fixo do mês: REAL (o que foi lançado), AVERAGE_3M
  /// (média dos últimos 3 meses, para o mês sem a conta não derrubar a meta) ou
  /// MANUAL (valor informado).
  fixedCostMode     String   @default("AVERAGE_3M")
  fixedCostManual   Decimal? @db.Decimal(10, 2)
  // ── Divisão do resultado ──
  /// Percentual do resultado que fica na reserva do ateliê.
  atelierPercent    Decimal  @default(20) @db.Decimal(5, 2)
  /// Meta de reserva, em meses de custo fixo.
  reserveTargetMonths Int    @default(3)
  /// Sinal de peça ainda não entregue sai do bolo a dividir.
  excludeUndeliveredSignals Boolean @default(true)
  /// Mês negativo é coberto pela reserva do ateliê...
  coverLossWithReserve      Boolean @default(true)
  /// ...e o que a reserva não cobrir abate do mês seguinte.
  carryLossToNextMonth      Boolean @default(true)
  // ── Maquininha ──
  // Zerado, o cartão se comporta como antes: valor cheio, disponível na hora.
  /// Taxa do débito, em % sobre a venda.
  cardDebitFeePercent   Decimal @default(0) @db.Decimal(5, 2)
  /// Taxa do crédito, em % sobre a venda.
  cardCreditFeePercent  Decimal @default(0) @db.Decimal(5, 2)
  /// Dias até o dinheiro do débito cair na conta.
  cardDebitDays         Int     @default(0)
  /// Dias até o dinheiro do crédito cair na conta.
  cardCreditDays        Int     @default(0)
  updatedAt   DateTime @updatedAt

  @@map("business_info")
}

// ── Auditoria ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
