# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=atelie
POSTGRES_USER=atelie
POSTGRES_PASSWORD=atelie123
DATABASE_URL=postgresql://atelie:atelie123@localhost:5432/atelie

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@localhost:6379

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio123456
MINIO_BUCKET=atelie
MINIO_ENDPOINT=localhost
MINIO_PORT=9000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── PgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@atelie.local
PGADMIN_PASSWORD=admin123

# ── Portas do host (produção) ─────────────────────────────────────────────────
# Só preencha se as portas padrão já estiverem ocupadas na máquina.
# HTTP_PORT=8080
# HTTPS_PORT=8443
# REDIS_PORT=6381

# Imagem do backend: precisa ter a mesma versão de OpenSSL do host, por causa
# dos engines nativos do Prisma. Padrão node:20-bookworm (OpenSSL 3).
# Só mude se o host tiver apenas OpenSSL 1.1:
# BACKEND_IMAGE=node:20-bullseye
