# Registry público explícito.
#
# Sem isto, um `npm install` feito em máquina com registry interno configurado
# (~/.npmrc) grava esse host no campo "resolved" do package-lock.json. O lock é
# versionado, então o endereço interno viaja junto e o `npm ci` quebra em
# qualquer máquina fora daquela rede com:
#   getaddrinfo ENOTFOUND <host-interno>
registry=https://registry.npmjs.org/
